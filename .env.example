# Copie ce fichier en .env.local et renseigne les valeurs.

# URL publique du site (sert aux liens de confirmation e-mail).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ---------------------------------
# L'URL et la clé publique ont une valeur par défaut dans
# src/lib/supabase/config.ts ; à renseigner uniquement pour viser un autre projet.
# NEXT_PUBLIC_SUPABASE_URL=
# Clé publique : "publishable" (sb_publishable_…) ou ancienne clé "anon".
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : sb_secret_… (ou "service_role"). Serveur uniquement, jamais exposée.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com → API Keys) ---------------------------
ANTHROPIC_API_KEY=
# Modèle utilisé par /api/generate. Défaut : claude-sonnet-5-5.
# Variante plus rapide et moins chère : claude-haiku-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Paiement ----------------------------------------------------------------
# Lien de paiement du plan Pro. Par défaut, le lien Whop défini dans
# src/lib/plans.ts ; à renseigner uniquement pour le remplacer.
# NEXT_PUBLIC_CHECKOUT_URL=https://whop.com/checkout/plan_CPkJSKD2HKOZP
# Secret de signature du webhook LemonSqueezy (Settings → Webhooks).
# Utile seulement si tu vends via LemonSqueezy.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Prix affiché sur la page Tarifs.
# NEXT_PUBLIC_PRO_PRICE=19 €
