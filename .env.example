# Copie ce fichier en .env.local et renseigne les valeurs.

# URL publique du site (sert aux liens de confirmation e-mail).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ---------------------------------
# L'URL et la clé publique ont une valeur par défaut dans
# src/lib/supabase/config.ts ; à renseigner uniquement pour viser un autre projet.
# NEXT_PUBLIC_SUPABASE_URL=
# Clé publique : "publishable" (sb_publishable_…) ou ancienne clé "anon".
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète, optionnelle : sb_secret_… (ou "service_role"). Serveur uniquement.
# Réserve le crédit avant chaque génération et sert au webhook LemonSqueezy.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA ----------------------------------------------------------------------
# Par défaut, rien à renseigner : les outils utilisent le générateur gratuit
# (Pollinations, sans clé, limité à environ une génération toutes les 30 s).
# Option : une clé Claude (platform.claude.com → API Keys) donne une meilleure
# qualité, sans file d'attente, facturée à l'usage.
ANTHROPIC_API_KEY=
# Modèle Claude. Défaut : claude-haiku-5-5 (le moins cher).
# Pour privilégier la qualité d'écriture, environ vingt fois plus cher :
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Paiement ----------------------------------------------------------------
# Lien de paiement du plan Pro. Par défaut, le lien Whop défini dans
# src/lib/plans.ts ; à renseigner uniquement pour le remplacer.
# NEXT_PUBLIC_CHECKOUT_URL=https://whop.com/checkout/plan_CPkJSKD2HKOZP
# Le secret du webhook Whop ne va pas ici : il est rangé dans la base
# (table app_secrets, voir supabase/migrations/0004_whop_webhook.sql).
# Clé API Whop (serveur) pour la résiliation en un clic depuis les Paramètres.
# Permission requise : membership:cancel. Sans cette clé, le bouton « Résilier »
# renvoie vers la gestion de l'abonnement sur Whop.
WHOP_API_KEY=
# Secret de signature du webhook LemonSqueezy (Settings → Webhooks).
# Utile seulement si tu vends via LemonSqueezy.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Prix affiché sur la page Tarifs.
# NEXT_PUBLIC_PRO_PRICE=19,99 €
